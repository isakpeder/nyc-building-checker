// TypeScript configuration, used for type checking only. Vite produces the build
// output.
{
  "compilerOptions": {
    // Type safety
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,

    // Language and runtime
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["chrome"],

    // Module handling, delegated to the bundler
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,

    // Required for per-file compilation by Vite
    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    // Output
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src", "manifest.config.ts", "vite.config.ts"]
}
